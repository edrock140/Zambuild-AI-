rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.keys().hasAll(['nickname', 'digitalId', 'language', 'startTime']);
      allow delete: if false;
    }
  }
}
